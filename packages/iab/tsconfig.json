{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "node_modules/.ts-dist",
    "types": ["node"]
  },
  "include": ["src", "package.json"],
  "exclude": ["src/**/*.test.ts"]
}